DATABASE_URL=postgresql://benchmark:benchmark@localhost:55432/orm_benchmark
POSTGRES_PORT=55432
PORT=3100
SIZE=1000
QUERY_COUNT=1000
MEASUREMENT_BACKEND=none
# Apple Silicon: powermetrics_zeus (requires requirements-mac.txt and sudo -v).
# Intel Linux: rapl. Both Mac collectors always run together.
POWER_SAMPLE_INTERVAL_MS=100
WORKLOAD_TIMEOUT_SECONDS=3600
SEED=42
TRIAL_COOLDOWN_SECONDS=30
ORM_COOLDOWN_SECONDS=10
IDLE_SECONDS=30
# Override mode defaults (pilot: 3 complete trials; experiment: 10):
# TRIALS=12
# Optional label stored in the full experiment manifest:
# EXPERIMENT_MACHINE_ID=mac-m4-pro
